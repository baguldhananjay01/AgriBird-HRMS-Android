<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardEmployeeForm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="#EAEFEA"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPersonalIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="#E8F5E9"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@drawable/user"
                android:contentDescription="Personal Information"
                app:tint="#2E7D32"/>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txtPersonalTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Personal Information"
            android:textColor="#112513"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/cardPersonalIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cardPersonalIcon"/>

        <TextView
            android:id="@+id/txtPersonalSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:text="Basic details of the employee"
            android:textColor="#667085"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/cardPersonalIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtPersonalTitle"/>

        <View
            android:id="@+id/dividerPersonal"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#EAEFEA"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardPersonalIcon"/>

        <!-- Full Name -->
        <TextView
            android:id="@+id/lblFullName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Full Name *"
            android:textColor="#112513"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerPersonal"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/nameContainer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edittext_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblFullName">

            <ImageView
                android:id="@+id/imgNameIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/user"
                android:contentDescription="Full Name"
                app:tint="#667085"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <EditText
                android:id="@+id/eName"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:hint="Enter full name"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="#112513"
                android:textColorHint="#98A2B3"
                android:textSize="13sp"
                app:layout_constraintStart_toEndOf="@id/imgNameIcon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Email -->
        <TextView
            android:id="@+id/lblEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Email Address *"
            android:textColor="#112513"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nameContainer"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/emailContainer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edittext_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblEmail">

            <ImageView
                android:id="@+id/imgEmailIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/mail"
                android:contentDescription="Email"
                app:tint="#667085"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <EditText
                android:id="@+id/eEmail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:hint="name@agribird.com"
                android:inputType="textEmailAddress"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="#112513"
                android:textColorHint="#98A2B3"
                android:textSize="13sp"
                app:layout_constraintStart_toEndOf="@id/imgEmailIcon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Phone -->
        <TextView
            android:id="@+id/lblPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Phone Number *"
            android:textColor="#112513"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/emailContainer"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/phoneContainer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edittext_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblPhone">

            <ImageView
                android:id="@+id/imgPhoneIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/telephone"
                android:contentDescription="Phone"
                app:tint="#667085"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <EditText
                android:id="@+id/ePhone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:hint="Enter 10-digit number"
                android:inputType="phone"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="#112513"
                android:textColorHint="#98A2B3"
                android:textSize="13sp"
                app:layout_constraintStart_toEndOf="@id/imgPhoneIcon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Emergency Contact Phone -->
        <TextView
            android:id="@+id/lblEmergencyPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Emergency Contact Number"
            android:textColor="#112513"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/phoneContainer"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/emergencyPhoneContainer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edittext_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblEmergencyPhone">

            <ImageView
                android:id="@+id/imgEmergencyPhoneIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/telephone"
                android:contentDescription="Emergency Contact"
                app:tint="#667085"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <EditText
                android:id="@+id/eEmergencyPhone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:hint="Family/Relative contact number"
                android:inputType="phone"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="#112513"
                android:textColorHint="#98A2B3"
                android:textSize="13sp"
                app:layout_constraintStart_toEndOf="@id/imgEmergencyPhoneIcon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Blood Group -->
        <TextView
            android:id="@+id/lblBloodGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Blood Group"
            android:textColor="#112513"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/emergencyPhoneContainer"/>

        <Spinner
            android:id="@+id/spBloodGroup"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edittext_background"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblBloodGroup"/>

        <!-- Residential Address -->
        <TextView
            android:id="@+id/lblAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Residential Address"
            android:textColor="#112513"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spBloodGroup"/>

        <EditText
            android:id="@+id/eAddress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edittext_background"
            android:gravity="top|start"
            android:hint="Enter full residential address"
            android:inputType="textMultiLine"
            android:lines="3"
            android:padding="12dp"
            android:textColor="#112513"
            android:textColorHint="#98A2B3"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblAddress"/>


        <!-- ============================= -->
        <!-- 2. EMPLOYMENT DETAILS         -->
        <!-- ============================= -->

        <View
            android:id="@+id/dividerEmployment"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#EAEFEA"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/eAddress"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEmploymentIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#E8F5E9"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerEmployment">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@drawable/job_description"
                android:contentDescription="Employment Details"
                app:tint="#2E7D32"/>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txtEmploymentTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Employment Details"
            android:textColor="#112513"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/cardEmploymentIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cardEmploymentIcon"/>

        <TextView
            android:id="@+id/txtEmploymentSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:text="Job and organization information"
            android:textColor="#667085"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/cardEmploymentIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtEmploymentTitle"/>

        <!-- Role -->
        <TextView
            android:id="@+id/lblRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Designated Role *"
            android:textColor="#112513"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardEmploymentIcon"/>

        <Spinner
            android:id="@+id/emRoleList"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edittext_background"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblRole"/>

        <!-- Department -->
        <TextView
            android:id="@+id/lblDepartment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Department *"
            android:textColor="#112513"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/emRoleList"/>

        <Spinner
            android:id="@+id/emList"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edittext_background"
            android:entries="@array/departments_array"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblDepartment"/>

        <!-- Employee ID -->
        <TextView
            android:id="@+id/lblEmployeeId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Employee ID *"
            android:textColor="#112513"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/emList"/>

        <EditText
            android:id="@+id/eEmpID"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edittext_background"
            android:hint="e.g., AB-2026-01"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="#112513"
            android:textColorHint="#98A2B3"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblEmployeeId"/>

        <!-- Joining Date -->
        <TextView
            android:id="@+id/lblJoiningDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Joining Date *"
            android:textColor="#112513"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/eEmpID"/>

        <EditText
            android:id="@+id/eJoiningDate"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edittext_background"
            android:clickable="true"
            android:focusable="false"
            android:hint="Select date"
            android:inputType="none"
            android:paddingHorizontal="12dp"
            android:textColor="#112513"
            android:textColorHint="#98A2B3"
            android:textSize="13sp"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblJoiningDate"/>


        <!-- ============================= -->
        <!-- 3. PORTAL SECURITY            -->
        <!-- ============================= -->

        <View
            android:id="@+id/dividerSecurity"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#EAEFEA"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/eJoiningDate"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSecurityIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#E8F5E9"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerSecurity">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@drawable/security"
                android:contentDescription="Portal Security"
                app:tint="#2E7D32"/>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txtSecurityTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Portal Security"
            android:textColor="#112513"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/cardSecurityIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/cardSecurityIcon"/>

        <TextView
            android:id="@+id/txtSecuritySubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:text="Login credentials for the employee"
            android:textColor="#667085"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/cardSecurityIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtSecurityTitle"/>

        <!-- Password Label & Input -->
        <TextView
            android:id="@+id/lblPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Password *"
            android:textColor="#112513"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardSecurityIcon"/>

        <EditText
            android:id="@+id/ePass"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edittext_background"
            android:hint="Minimum 6 characters"
            android:inputType="textPassword"
            android:paddingHorizontal="12dp"
            android:textColor="#112513"
            android:textColorHint="#98A2B3"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblPassword"/>

        <!-- Confirm Password Label & Input -->
        <TextView
            android:id="@+id/lblPassCon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Confirm Password *"
            android:textColor="#112513"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ePass"/>

        <EditText
            android:id="@+id/ePassCon"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/edittext_background"
            android:hint="Re-enter password"
            android:inputType="textPassword"
            android:paddingHorizontal="12dp"
            android:textColor="#112513"
            android:textColorHint="#98A2B3"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblPassCon"/>

        <!-- Add Employee Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegi"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="Add Employee"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#2E7D32"
            app:cornerRadius="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ePassCon"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>