<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="500dp"
    android:background="@color/background_green">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/attendanceContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPunch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <!-- "LOGGED IN AS" -->
                <TextView
                    android:id="@+id/labelLoggedIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOGGED IN AS"
                    android:textColor="@color/hint_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Employee Name -->
                <TextView
                    android:id="@+id/txtEmpName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dhananjay Bagul"
                    android:textColor="@color/primary_text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/labelLoggedIn" />

                <!-- Status Badge -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/badge_background"
                    android:backgroundTint="@color/badge_present_bg"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txtEmpName">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/icon_circle_green"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/txtTodayStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Present"
                        android:textColor="@color/green_dark"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp"
                        app:layout_constraintStart_toEndOf="@+id/statusDot"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Current Time -->
                <TextView
                    android:id="@+id/txtTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:30 AM"
                    android:textColor="@color/green_primary"
                    android:textSize="36sp"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:layout_marginTop="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layoutStatusBadge" />

                <!-- Date Chip -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/dateChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/badge_background"
                    android:backgroundTint="@color/date_bg"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txtTime">

                    <TextView
                        android:id="@+id/txtDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wednesday, 17 June 2026"
                        android:textColor="@color/date_text"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Check‑In Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckIn"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="24dp"
                    android:text="Punch Check In"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:cornerRadius="25dp"
                    app:backgroundTint="@color/green_primary"
                    app:elevation="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dateChip" />

                <!-- Check‑Out Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckOut"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:text="Check Out"
                    android:textColor="@color/red_checkout"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:cornerRadius="25dp"
                    android:backgroundTint="@color/checkout_bg"
                    app:strokeColor="@color/checkout_stroke"
                    app:strokeWidth="1dp"
                    app:elevation="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btnCheckIn" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardShift"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardPunch">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Left: Shift Schedule -->
                <TextView
                    android:id="@+id/labelShift"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="SHIFT SCHEDULE"
                    android:textColor="@color/hint_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/dividerShift" />

                <TextView
                    android:id="@+id/txtShiftTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="09:30 AM - 06:30 PM"
                    android:textColor="@color/primary_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    app:layout_constraintStart_toStartOf="@+id/labelShift"
                    app:layout_constraintTop_toBottomOf="@+id/labelShift"
                    app:layout_constraintEnd_toEndOf="@+id/labelShift" />

                <!-- Vertical Divider -->
                <View
                    android:id="@+id/dividerShift"
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:background="@color/divider"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp" />

                <!-- Right: Total Logged Hours -->
                <TextView
                    android:id="@+id/labelHours"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="TOTAL LOGGED HOURS"
                    android:textColor="@color/hint_text"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@+id/dividerShift"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/txtTotalLoggedHours"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="00h 00m"
                    android:textColor="@color/green_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    app:layout_constraintStart_toStartOf="@+id/labelHours"
                    app:layout_constraintTop_toBottomOf="@+id/labelHours"
                    app:layout_constraintEnd_toEndOf="@+id/labelHours" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- =========================== -->
        <!-- 3. QUICK STATS CARD         -->
        <!-- =========================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardQuickStats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardShift"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Title -->
                <TextView
                    android:id="@+id/titleQuickStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's Activity"
                    android:textColor="@color/primary_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Online Time -->
                <TextView
                    android:id="@+id/labelOnline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Online"
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp"
                    android:layout_marginTop="12dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/titleQuickStats" />

                <TextView
                    android:id="@+id/txtOnlineTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5h 20m"
                    android:textColor="@color/green_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@+id/labelOnline"
                    app:layout_constraintTop_toBottomOf="@+id/labelOnline" />

                <!-- Break Time -->
                <TextView
                    android:id="@+id/labelBreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Break"
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/txtOnlineTime"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/txtBreakTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45m"
                    android:textColor="@color/orange_leave"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="@+id/labelBreak"
                    app:layout_constraintTop_toBottomOf="@+id/labelBreak" />

                <!-- Yesterday's Status -->
                <TextView
                    android:id="@+id/labelYesterday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yesterday"
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/titleQuickStats"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/txtYesterdayStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Present"
                    android:textColor="@color/green_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/labelYesterday"
                    app:layout_constraintTop_toBottomOf="@+id/labelYesterday" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>