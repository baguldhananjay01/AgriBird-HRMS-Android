<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp">

        <View
            android:id="@+id/viewAdminStatusIndicator"
            android:layout_width="5dp"
            android:layout_height="0dp"
            android:background="#FF9800"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEmpIconBg"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#F0F4F8"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toEndOf="@+id/viewAdminStatusIndicator"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgEmpIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/user"
                app:tint="#4A5568" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/txtAdminEmpName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="Dhananjay Shinde"
            android:textColor="#1A202C"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/cardAdminStatusContainer"
            app:layout_constraintStart_toEndOf="@+id/cardEmpIconBg"
            app:layout_constraintTop_toTopOf="@+id/cardEmpIconBg" />

        <TextView
            android:id="@+id/txtAdminEmpId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Emp ID: AB102"
            android:textColor="#718096"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@+id/txtAdminEmpName"
            app:layout_constraintStart_toStartOf="@+id/txtAdminEmpName"
            app:layout_constraintTop_toBottomOf="@+id/txtAdminEmpName" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAdminStatusContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="#FFF3E0"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/txtAdminEmpId"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/txtAdminEmpName">

            <TextView
                android:id="@+id/txtAdminLeaveStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="Pending"
                android:textColor="#FF9800"
                android:textSize="11sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <View
            android:id="@+id/adminDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#EDF2F7"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/viewAdminStatusIndicator"
            app:layout_constraintTop_toBottomOf="@+id/cardEmpIconBg" />

        <TextView
            android:id="@+id/txtAdminLeaveType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Sick Leave"
            android:textColor="#2D3748"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/btnViewDetails"
            app:layout_constraintStart_toStartOf="@+id/cardEmpIconBg"
            app:layout_constraintTop_toBottomOf="@+id/adminDivider" />

        <TextView
            android:id="@+id/txtAdminLeaveDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="16 Jul 2026 - 18 Jul 2026"
            android:textColor="#718096"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="@+id/txtAdminLeaveType"
            app:layout_constraintStart_toStartOf="@+id/txtAdminLeaveType"
            app:layout_constraintTop_toBottomOf="@+id/txtAdminLeaveType" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewDetails"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="View Details"
            android:textColor="#2E7D32"
            android:textSize="13sp"
            android:textStyle="bold"
            app:icon="@drawable/arrow"
            app:iconGravity="end"
            app:iconSize="16dp"
            app:iconTint="#2E7D32"
            app:layout_constraintBottom_toBottomOf="@+id/txtAdminLeaveDate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/txtAdminLeaveType" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
